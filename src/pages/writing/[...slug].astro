---
import { render, type CollectionEntry } from 'astro:content';
import EssayReader from '../../components/essay/EssayReader.astro';
import Layout from '../../layouts/Layout.astro';
import { getWriting, dateLabel, local } from '../../lib/writing';
export async function getStaticPaths() { return (await getWriting()).map(piece => ({ params: { slug: piece.id }, props: { piece } })); }
interface Props { piece: CollectionEntry<'writing'>; }
const { piece } = Astro.props;
const { Content, headings } = await render(piece);
const essay = piece.data.experience === 'essay';
---
<Layout title={piece.data.title} description={piece.data.summary} atUri={piece.data.atUri} reading={!essay}>
  <header class:list={['page-heading', {'essay-heading': essay}]}><a class="eyebrow" href={local('writing/')}>← The writing</a>{piece.data.draft && <p class="draft-label meta">Draft · local preview</p>}{piece.data.status === 'working-draft' && <p class="essay-status meta">Working draft · open for exploration</p>}<h1>{piece.data.title}</h1><p class="lead">{piece.data.summary}</p><div class="byline meta"><span>{piece.data.authors.map((author, i) => <>{i > 0 && ' & '}{author.url ? <a href={author.url}>{author.name}</a> : author.name}</>)}</span><time datetime={piece.data.date.toISOString()}>{dateLabel(piece.data.date)}</time></div>{piece.data.provenance && <p class="essay-provenance meta">{piece.data.provenance}</p>}<div class="sunset" aria-hidden="true"></div></header>
  {essay ? <EssayReader headings={headings} slug={piece.id}><Content /></EssayReader> : <article class="prose"><Content /></article>}
  <footer class="piece-footer">{piece.data.atUri && <p class="meta">Also on atproto: <a href={piece.data.atUri}>{piece.data.atUri}</a></p>}<a class="meta" href={local('writing/')}>← Back to all writing</a></footer>
</Layout>
